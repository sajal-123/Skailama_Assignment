# Runtime environment: development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=5000

# MongoDB connection string (local mongod, Docker mongo:7, or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/event-management

# Allowed CORS origin(s). Use "*" for any (dev only), or a comma-separated
# list of exact origins for production, e.g. https://app.example.com,https://admin.example.com
CLIENT_ORIGIN=*

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
